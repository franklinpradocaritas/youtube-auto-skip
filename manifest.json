{
    "manifest_version": 3,
    "name": "YouTube Auto Skip",
    "version": "1.0.0",
    "minimum_chrome_version": "118",
    "description": "Automatically skips ads using debugger clicks, with popup controls and an animated ribbon.",
    "permissions": ["activeTab", "scripting", "storage", "debugger"],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "YouTube Auto Skip",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*",
                "https://m.youtube.com/*"
            ],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    }
}
